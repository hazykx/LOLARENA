# Adresa webu (bez lomítka na konci). Musí sedět s Redirect URL v Discord Developer Portalu.
# Na Railway ji NEMUSÍŠ vyplňovat – vezme se automaticky z vygenerované domény.
BASE_URL=http://localhost:3000
PORT=3000
# Volitelné – když chybí, vygeneruje se a uloží do databáze.
SESSION_SECRET=
# Volitelné – cesta k databázi. Na Railway se sama použije připojená volume.
DB_FILE=

# Discord aplikace (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# ID Discord serveru, kde bot zakládá voice roomky
DISCORD_GUILD_ID=
# (volitelné) kategorie, do které se roomky zakládají
DISCORD_VOICE_CATEGORY_ID=
# (volitelné) textový kanál pro oznámení (draft začal, zápas začíná, výsledek)
DISCORD_ANNOUNCE_CHANNEL_ID=
# true = do roomky se připojí jen hráči daného týmu
PRIVATE_VOICE=true
# posílat hráčům DM (hra nalezena, lobby + odkaz na voice)
SEND_DMS=true

# Discord ID adminů oddělená čárkou (rušení zápasů, řešení sporů)
ADMIN_DISCORD_IDS=

# (volitelné) Riot API klíč – ověří, že přidaný Riot ID existuje, a uloží PUUID
RIOT_API_KEY=

# Časovače (sekundy)
READY_SECONDS=60
PICK_SECONDS=30
DISCONNECT_GRACE_SECONDS=60
ELO_K=32

# Testování bez Discordu: /auth/dev?name=Jmeno + scripts/simulate.js. V produkci VYPNOUT!
DEV_LOGIN=false
